# =====================================================
# AutoHôte — Variables d'environnement (modèle public)
# =====================================================
# Copie ce fichier vers ".env" puis remplis avec tes vraies valeurs.
# Le ".env" est ignoré par Git (voir .gitignore) — NE JAMAIS le commiter.

# --- Hostinger VPS ---
# Adresse IP publique de ton VPS (format : 123.45.67.89)
N8N_HOST=XXX.XXX.XXX.XXX

# --- PostgreSQL (base de données applicative) ---
# Identifiants de la BDD utilisée pour stocker logements/conversations/messages.
# Choisis un mot de passe fort — postgres n'est pas exposé sur internet
# mais c'est une bonne hygiène.
POSTGRES_USER=autohote
POSTGRES_PASSWORD=remplace_par_mot_de_passe_postgres_fort
POSTGRES_DB=autohote

# --- Identifiants n8n (connexion au dashboard) ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=remplace_par_un_mot_de_passe_fort

# --- Clé de chiffrement n8n ---
# Génère une chaîne aléatoire de 64 caractères hex avec :
#   openssl rand -hex 32
# Une fois définie en prod, NE JAMAIS la changer (perte d'accès aux credentials stockés)
N8N_ENCRYPTION_KEY=remplace_par_64_caracteres_hex

# --- Claude API (Anthropic) ---
# Récupère ta clé sur https://console.anthropic.com (Menu API keys)
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxx

# --- Apify ---
# Récupère ton token sur https://console.apify.com (Settings → Integrations)
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxx

# --- Dashboard de validation (Flask) ---
# Authentification HTTP Basic pour accéder à http://[IP_VPS]:8080
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=mot_de_passe_dashboard_fort

# --- Webhook de réception générique (test, sources internes) ---
# Token partagé envoyé dans le header X-Webhook-Secret.
# Génère avec : openssl rand -hex 24
WEBHOOK_SECRET=token_webhook_aleatoire_64_chars

# --- Mailgun (réception d'emails Airbnb) ---
# Webhook signing key fourni par Mailgun :
# Mailgun Dashboard → Settings → Webhooks → Webhook Signing Key
MAILGUN_SIGNING_KEY=webhook_signing_key_de_mailgun
